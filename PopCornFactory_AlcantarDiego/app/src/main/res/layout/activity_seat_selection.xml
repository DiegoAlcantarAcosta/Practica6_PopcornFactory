    <LinearLayout
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_gravity="center_horizontal"
        android:paddingHorizontal="@dimen/paddingGroup"
        android:layout_height="70dp">
        
        
        <ImageView
            android:src="@drawable/radio_normal"
            android:layout_width="@dimen/symbols"
            android:layout_gravity="center_vertical"
            android:layout_height="@dimen/symbols">

        </ImageView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Available"
            android:layout_gravity="center_vertical"
            android:textSize="15sp"
            android:layout_marginLeft="5dp"
            android:textColor="@color/letra">

        </TextView>

        <ImageView
            android:src="@drawable/radio_disabled"
            android:layout_width="@dimen/symbols"
            android:layout_gravity="center_vertical"
            android:layout_height="@dimen/symbols">

        </ImageView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Not \nAvailable"
            android:layout_gravity="center_vertical"
            android:textSize="15sp"
            android:layout_marginLeft="5dp"
            android:textColor="@color/letra">

        </TextView>

        <ImageView
            android:src="@drawable/radio_selected"
            android:layout_width="@dimen/symbols"
            android:layout_gravity="center_vertical"
            android:layout_height="@dimen/symbols">

        </ImageView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Your \nselection"
            android:layout_gravity="center_vertical"
            android:textSize="15sp"
            android:layout_marginLeft="5dp"
            android:textColor="@color/letra">

